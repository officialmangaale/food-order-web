NEXT_PUBLIC_RESTAURANT_SERVICE_BASE_URL=https://restaurant-prod.mangaale.com
NEXT_PUBLIC_RESTAURANT_SERVICE_WS_BASE_URL=https://restaurant-prod.mangaale.com
NEXT_PUBLIC_USER_SERVICE_BASE_URL=https://user-prod.mangaale.com
NEXT_PUBLIC_APP_URL=https://food.mangaale.com

# Loyalty reads go through the same-origin Next.js proxy. Keep the service URL server-only.
NEXT_PUBLIC_LOYALTY_UI_ENABLED=false
LOYALTY_SERVICE_BASE_URL=http://loyalty-service:8090

# Maps foundation only; no Maps script is loaded by checkout.
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=true
NEXT_PUBLIC_CUSTOMER_MAP_PICKER_ENABLED=true
NEXT_PUBLIC_GOOGLE_PLACES_ENABLED=true
NEXT_PUBLIC_GOOGLE_GEOCODING_ENABLED=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_WEB_CUSTOMER_TRACKING_MAP_ENABLED=true
